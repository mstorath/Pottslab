{
    "name": "pottslab (Claude Code yolo)",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // NET_ADMIN / NET_RAW are required so the post-create firewall script
    // can install iptables/ipset rules.  The firewall allows DNS, SSH,
    // HTTP/HTTPS outbound (so Claude Code's WebFetch works on any site),
    // a pinned ipset for apt/npm/pip, and the docker bridge.  Everything
    // else — non-web TCP, non-DNS UDP, all inbound — is DROPped by default.
    "runArgs": [
        "--cap-add=NET_ADMIN",
        "--cap-add=NET_RAW"
    ],

    "remoteUser": "claude",
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",

    // Mounts:
    //   - /commandhistory: persisted zsh history
    //   - /home/claude/.claude-persist: a helper directory that holds
    //     Claude Code's state.  post-create.sh symlinks ~/.claude and
    //     ~/.claude.json into it so that the OAuth token, per-project
    //     memory, and settings all persist across container rebuilds —
    //     i.e. you log in once and stay logged in.
    "mounts": [
        "source=pottslab-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
        "source=pottslab-claude-persist-${devcontainerId},target=/home/claude/.claude-persist,type=volume"
    ],

    // CLAUDE_CODE_OAUTH_TOKEN / ANTHROPIC_API_KEY are pulled from the host
    // shell environment.  Use `claude setup-token` on the *host* once to
    // generate a 1-year OAuth token tied to your Claude subscription, export
    // it in your shell, then open this container — Claude Code will pick it
    // up and skip the interactive /login flow entirely.  (The random-port
    // OAuth callback that `claude /login` uses is not reliably forwarded
    // out of devcontainers, which is why the interactive flow hangs.)
    // If the host var is unset these entries expand to empty strings and
    // Claude Code will fall through to its normal login prompt.
    "remoteEnv": {
        "PYTHONPATH": "/workspace",
        "DEVCONTAINER": "true",
        "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
        "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
    },

    "customizations": {
        "vscode": {
            // Deliberately NOT installing `anthropic.claude-code` here.
            // That extension aggressively rewrites ~/.claude.json on every
            // VS Code launch and strips fields like `hasCompletedOnboarding`
            // and `hasTrustDialogAccepted`, which then forces the CLI into
            // the interactive login wizard (which hangs inside a devcontainer
            // because the OAuth callback port isn't forwarded).  Use the CLI
            // via `yolo` / `claude` in the integrated terminal instead.
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "vscjava.vscode-java-pack"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh",
                "python.defaultInterpreterPath": "/usr/local/bin/python3",
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": ["tests"]
            }
        }
    },

    // All one-shot setup lives in post-create.sh: firewall init and the
    // Claude-login-persistence symlinks.
    "postCreateCommand": "/workspace/.devcontainer/post-create.sh"
}
